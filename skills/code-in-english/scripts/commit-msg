#!/bin/sh
# Rejects a commit message that does not read as English (code-in-english skill).
# Heuristic: an accented Latin letter, or two common words of French, German or Spanish; text between
# backticks or double quotes is ignored. False positive: git commit --no-verify.

# Prints the lines of stdin that do not read as English.
foreign() {
  LC_ALL=C awk '
    BEGIN {
      n = split("le la les un une des du et est sont pour avec dans sur pas qui que ne ces cette aux ajoute ajout corrige correction fichier fichiers und nicht ist das der wird auf eine los las una para por del esta pero", w, " ")
      for (i = 1; i <= n; i++) stop[w[i]] = 1
    }
    {
      line = $0
      gsub(/`[^`]*`/, "", line)
      gsub(/"[^"]*"/, "", line)
      if (line ~ /\303|\305\223|\305\222/) { print $0; next }
      t = tolower(line)
      gsub(/[^a-z]+/, " ", t)
      split("", seen)
      hits = 0
      m = split(t, words, " ")
      for (j = 1; j <= m; j++) if ((words[j] in stop) && !(words[j] in seen)) { seen[words[j]] = 1; hits++ }
      if (hits >= 2) print $0
    }'
}

bad=$(grep -v '^#' "$1" | grep -viE '^[[:space:]]*[a-z-]+-by:' | foreign)
if [ -n "$bad" ]; then
  echo "Commit message must be in English (code-in-english):" >&2
  printf '%s\n' "$bad" | sed 's/^/  /' >&2
  echo "False positive? git commit --no-verify" >&2
  exit 1
fi
